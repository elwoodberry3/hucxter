# Copy to .env.local for local development. Never commit real values.
# Only NEXT_PUBLIC_* variables reach the browser; there are none yet.

# Public origin of the web app (metadata, canonical URLs, later CSRF checks).
# Required in production. Defaults to http://localhost:3000 in development.
APP_ORIGIN=http://localhost:3000

# Git commit reported by GET /api/health. Optional; Vercel provides VERCEL_GIT_COMMIT_SHA.
GIT_COMMIT_SHA=
