# Copy to .env.local for local development. Never commit real values.
# Only NEXT_PUBLIC_* variables reach the browser; there are none.

# --- App ---------------------------------------------------------------
# Deployment tier: local | qa | production. A production build with APP_ENV unset is production.
APP_ENV=local
# Public origin of the web app (canonical URLs, Origin/CSRF checks). Required in production.
APP_ORIGIN=http://localhost:3000
# Optional; Vercel provides VERCEL_GIT_COMMIT_SHA.
GIT_COMMIT_SHA=
# Guest location fallback when no IP location is available. Launch area: Portland (D-35).
DEFAULT_AREA_ZIP=97205

# --- Supabase ----------------------------------------------------------
# Local values come from `supabase status`. The publishable key below is the CLI's fixed local key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# SERVER ONLY. Secret/service-role key. Locally: `supabase status` -> Secret key. Never commit a value.
SUPABASE_SECRET_KEY=

# --- Accounts (Brief 03B) ----------------------------------------------
# QA invite gate. Default: true when APP_ENV=qa, otherwise false.
INVITE_ONLY=false
# Bot challenge: turnstile | none. "none" is refused when APP_ENV=production.
CAPTCHA_PROVIDER=none
# Cloudflare's public TEST keys (always pass). Real keys live only in the hosting secret store.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Video (Brief 03C.1) -----------------------------------------------
# mux | fake. Default: fake when APP_ENV=local, otherwise mux. "fake" is refused outside local.
VIDEO_PROVIDER=fake
# Optional limits (defaults 60 seconds, 500 MB).
MEDIA_MAX_SECONDS=60
MEDIA_MAX_BYTES=524288000
# Only needed when VIDEO_PROVIDER=mux. See docs/runbooks/video.md. Never commit values.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# --- Jobs --------------------------------------------------------------
# Protects /api/cron/jobs. At least 32 random characters: `openssl rand -hex 32`.
CRON_SECRET=