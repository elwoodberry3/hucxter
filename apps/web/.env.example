# Copy to .env.local for local development. Never commit real values.
# Only NEXT_PUBLIC_* variables reach the browser; there are none yet.

# Deployment tier: local | qa | production. Production hides /dev routes and demo fixtures.
# A production build with APP_ENV unset is treated as production.
APP_ENV=local

# Public origin of the web app (metadata, canonical URLs, later CSRF checks).
# Required in production. Defaults to http://localhost:3000 in development.
APP_ORIGIN=http://localhost:3000

# Git commit reported by GET /api/health. Optional; Vercel provides VERCEL_GIT_COMMIT_SHA.
GIT_COMMIT_SHA=

# Supabase API for server-side reads (public, RLS-limited data). Local values come from
# `supabase status`. Use the publishable key only, never the secret/service-role key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Guest location fallback when no IP location is available (local dev). A 5-digit ZIP from
# the seeded region.
DEFAULT_AREA_ZIP=75009
